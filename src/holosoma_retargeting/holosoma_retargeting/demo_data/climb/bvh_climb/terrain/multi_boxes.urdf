<?xml version="1.0"?>
<robot name="multi_boxes">
  <!-- Box 1: climbing obstacle (54cm tall) -->
  <link name="multi_boxes_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="box_models/box1.obj" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="box1_material">
        <color rgba="0.3 0.7 0.9 0.5"/>
      </material>
    </visual>

    <collision name="multi_boxes_box1">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="box_models/box1.obj" scale="1.0 1.0 1.0"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="33.33"/>
      <inertia ixx="33.33" ixy="0.0" ixz="0.0" iyy="33.33" iyz="0.0" izz="33.33"/>
    </inertial>
  </link>
</robot>
